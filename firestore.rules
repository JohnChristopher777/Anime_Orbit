rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and Ownership Helpers
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Private account documents and personal media collections.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /watchlist/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /watched/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /favourites/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /trash/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /tierSheets/{sheetId} {
        allow read, write: if isOwner(userId)
          && sheetId in ['slot-1', 'slot-2', 'slot-3', 'slot-4', 'slot-5']
          && request.resource.data.keys().hasOnly(['name', 'animeTiers', 'mangaTiers', 'updatedAt'])
          && isValidString(request.resource.data.name, 1, 40)
          && request.resource.data.animeTiers is list
          && request.resource.data.animeTiers.size() <= 20
          && request.resource.data.mangaTiers is list
          && request.resource.data.mangaTiers.size() <= 20
          && isValidString(request.resource.data.updatedAt, 1, 100);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId)
          || (isAuthenticated()
            && resource.data.actorId == request.auth.uid
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.recipientId == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'actorName', 'actorAvatar', 'preview', 'createdAt', 'read', 'mediaType'
            ]));
        allow create: if isAuthenticated()
          && request.resource.data.recipientId == userId
          && request.resource.data.actorId == request.auth.uid
          && request.auth.uid != userId
          && request.resource.data.type in ['reply', 'like', 'controversial']
          && request.resource.data.keys().hasOnly([
            'type', 'mediaType', 'recipientId', 'actorId', 'actorName', 'actorAvatar',
            'animeId', 'animeTitle', 'commentId', 'parentId',
            'sourceCommentId', 'preview', 'read', 'createdAt'
          ])
          && isValidString(request.resource.data.actorName, 1, 30)
          && isValidString(request.resource.data.preview, 0, 240)
          && isValidString(request.resource.data.animeId, 1, 30)
          && isValidString(request.resource.data.animeTitle, 1, 180)
          && request.resource.data.mediaType in ['ANIME', 'MANGA']
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'like'
              && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
              && get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.userId == userId)
            ||
            (request.resource.data.type == 'reply'
              && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
              && get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.userId == request.auth.uid
              && exists(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId))
              && get(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId)).data.userId == userId)
            ||
            (request.resource.data.type == 'controversial'
              && exists(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId))
              && get(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId)).data.userId == userId
              && get(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId)).data.dislikes is list
              && get(/databases/$(database)/documents/comments/$(request.resource.data.sourceCommentId)).data.dislikes.size() >= 10)
          );
      }
    }

    // Deliberately public profile projection. Sensitive account preferences
    // remain in /users and cannot be queried by other visitors.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'userId', 'bio', 'avatarUrl', 'bannerUrl',
          'favoriteGenre', 'createdAt', 'updatedAt', 'libraryUpdatedAt',
          'watchlist', 'favourites', 'stats'
        ])
        && isValidString(request.resource.data.displayName, 1, 15)
        && isValidString(request.resource.data.userId, 0, 24)
        && isValidString(request.resource.data.bio, 0, 500)
        && isValidString(request.resource.data.avatarUrl, 0, 2048)
        && isValidString(request.resource.data.bannerUrl, 0, 2048)
        && isValidString(request.resource.data.favoriteGenre, 1, 40)
        && isValidString(request.resource.data.createdAt, 1, 100)
        && isValidString(request.resource.data.updatedAt, 1, 100)
        && request.resource.data.get('libraryUpdatedAt', '') is string
        && request.resource.data.get('watchlist', []) is list
        && request.resource.data.get('watchlist', []).size() <= 100
        && request.resource.data.get('favourites', []) is list
        && request.resource.data.get('favourites', []).size() <= 100
        && request.resource.data.get('stats', {}) is map;
      allow delete: if isOwner(userId);
    }

    // Root collections for atomic user data (Watchlists, Tierlists, Favourites)
    match /favourites/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /watchlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // One authenticated vote per user and weekly poll.
    match /seasonPolls/{pollId} {
      allow read: if true;

      match /votes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId)
          && request.resource.data.voterKey == userId
          && request.resource.data.animeId is int
          && request.resource.data.keys().hasOnly(['animeId', 'voterKey', 'updatedAt']);
        allow update: if isOwner(userId)
          && request.resource.data.voterKey == userId
          && resource.data.voterKey == userId
          && request.resource.data.animeId is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['animeId', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Anime Reviews (Validated string lengths and owner-only update/delete)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.mediaType in ['ANIME', 'MANGA']
        && reviewId == request.resource.data.mediaType + '_'
          + (request.resource.data.mediaType == 'MANGA' ? request.resource.data.mangaId : request.resource.data.animeId)
          + '_' + request.auth.uid
        && isValidString(request.resource.data.content, 1, 3000);
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'text', 'rating', 'updatedAt'])
        && isValidString(request.resource.data.content, 1, 3000);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Anime Comments & Community Discussions (XSS and Spam hardened)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 2000);
      allow update: if isAuthenticated() 
        && ((resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'text', 'isSpoiler', 'updatedAt'])
          && isValidString(request.resource.data.content, 1, 2000))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'reports'])
            && request.resource.data.get('likes', []) is list
            && request.resource.data.get('dislikes', []) is list
            && request.resource.data.get('reports', []) is list
            && request.resource.data.get('likes', []).size() <= 10000
            && request.resource.data.get('dislikes', []).size() <= 10000
            && request.resource.data.get('reports', []).size() <= 1000));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
