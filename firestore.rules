rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and Ownership Helpers
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Private account documents and personal media collections.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /watchlist/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /watched/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /favourites/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /trash/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deliberately public profile projection. Sensitive account preferences
    // remain in /users and cannot be queried by other visitors.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'userId', 'bio', 'avatarUrl', 'bannerUrl',
          'favoriteGenre', 'createdAt', 'updatedAt'
        ])
        && isValidString(request.resource.data.displayName, 1, 15)
        && isValidString(request.resource.data.userId, 0, 24)
        && isValidString(request.resource.data.bio, 0, 500)
        && isValidString(request.resource.data.avatarUrl, 0, 2048)
        && isValidString(request.resource.data.bannerUrl, 0, 2048)
        && isValidString(request.resource.data.favoriteGenre, 1, 40)
        && isValidString(request.resource.data.createdAt, 1, 100)
        && isValidString(request.resource.data.updatedAt, 1, 100);
      allow delete: if isOwner(userId);
    }

    // Root collections for atomic user data (Watchlists, Tierlists, Favourites)
    match /favourites/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /watchlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // One authenticated vote per user and weekly poll.
    match /seasonPolls/{pollId} {
      allow read: if true;

      match /votes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId)
          && request.resource.data.voterKey == userId
          && request.resource.data.animeId is int
          && request.resource.data.keys().hasOnly(['animeId', 'voterKey', 'updatedAt']);
        allow update: if isOwner(userId)
          && request.resource.data.voterKey == userId
          && resource.data.voterKey == userId
          && request.resource.data.animeId is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['animeId', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Anime Reviews (Validated string lengths and owner-only update/delete)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 3000);
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'text', 'rating', 'updatedAt'])
        && isValidString(request.resource.data.content, 1, 3000);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Anime Comments & Community Discussions (XSS and Spam hardened)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 2000);
      allow update: if isAuthenticated() 
        && ((resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'text', 'isSpoiler', 'updatedAt'])
          && isValidString(request.resource.data.content, 1, 2000))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'reports'])
            && request.resource.data.get('likes', []) is list
            && request.resource.data.get('dislikes', []) is list
            && request.resource.data.get('reports', []) is list
            && request.resource.data.get('likes', []).size() <= 10000
            && request.resource.data.get('dislikes', []).size() <= 10000
            && request.resource.data.get('reports', []).size() <= 1000));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
