# Firebase Configuration
# Get these values from your Firebase Console
# https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# Keep the Firebase callback domain here even when the public app is hosted on
# web.app. Authorize the public host and localhost in Firebase Authentication.
# Google OAuth callback: https://your_project_id.firebaseapp.com/__/auth/handler
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# MangaDex public manga/chapter metadata does not require a key. If an OAuth
# access token is used for a protected MangaDex operation, keep it server-only.
# Never prefix a MangaDex client secret or access token with VITE_: Vite exposes
# those values to the browser bundle.
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_ACCESS_TOKEN=

# Server-only Gemini key used by /api/discovery for screenshot, scene, and
# dialogue analysis. Never rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=


# Note: After creating your .env file with actual values, add it to .gitignore
# The .env.example file should be committed to your repository as a template
